   "args": {
    "code": "const songs = {\n\"Beyond the Horizon\":588,\"Bright Lights\":133,\"City of Stars\":197,\"Dreamer's Awake\":287,\"Echoes of Silence\":207,\"Endless Summer\":294,\"Eternal Flame\":232,\"Heartbeat Away\":620,\"Moments\":282,\"My Heart is Yours\":235,\"Mystic Journey\":60,\"Rising Sun\":84,\"Twilight Calling\":637,\"Under the Sky\":149,\"Voices in the Hall\":378};\nconst names = Object.keys(songs);\nlet best=null;\nfor(let mask=1;mask<(1<<names.length);mask++){\n  let t=0, sel=[];\n  for(let i=0;i<names.length;i++){ if(mask&(1<<i)){ t+=songs[names[i]]; sel.push(names[i]); } }\n  if(t>=2700 && t<=3000){ if(!best || t>best.t) best={t,sel}; }\n}\nreturn best;"
   }
